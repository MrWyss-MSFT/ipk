{
  "name": "itprokit",
  "version": "0.1.0",
  "description": "ItProKit (IPK) — handy static tools for IT Pros managing endpoints with Microsoft technologies.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/TODO/ipk"
  },
  "scripts": {
